# Frontend base URL used to build the links we email out (password reset and
# account activation). MUST be set to the public URL in any deployed
# environment, otherwise recipients get links to their own machine.
FRONTEND_URL=http://localhost:3000

# Email Configuration
# Set SEND_REAL_EMAILS=true to actually send emails (otherwise they are just logged)
SEND_REAL_EMAILS=false

# SMTP Configuration (for Gmail, use App Password not your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@kanatamusic.com
SMTP_FROM_NAME=Kanata Music Academy

# Seconds to wait on the SMTP socket before giving up
SMTP_TIMEOUT=15

# Application log level (DEBUG/INFO/WARNING/ERROR). The startup diagnostic that
# reports which email mode is active is logged at INFO.
LOG_LEVEL=INFO
